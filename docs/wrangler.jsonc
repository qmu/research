// Cloudflare Worker that serves the built VitePress preview site.
//
// This is a hosted PREVIEW surface, not a publishing surface: the published
// articles still travel to qmu-co-jp as Markdown (docs/adr/0003-*). See the
// Deploy section of CLAUDE.md.
//
// Nothing here is invoked with wrangler flags from a workflow file — the deploy
// runs through `make deploy-docs`, which calls the `deploy` script in
// package.json ("one runner").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-docs-staging",
  "compatibility_date": "2026-08-18",
  // An unattended CI deploy should make no outbound call it was not asked for.
  "send_metrics": false,
  "assets": {
    // Written by `npm run build` (vitepress build); untracked, see .gitignore.
    "directory": ".vitepress/dist",
    // The site sets `cleanUrls: true`, so pages are linked without `.html`
    // while the build emits `<page>.html`. The assets runtime resolves that
    // itself — VitePress's own `preview` server is not proof of this, so the
    // mapping is stated here rather than assumed.
    "html_handling": "auto-trailing-slash",
    // Serve VitePress's built 404.html rather than a bare runtime 404.
    "not_found_handling": "404-page"
  }
}
