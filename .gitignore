node_modules/
dist/
outputs/*
!outputs/.gitkeep

# Local git worktrees (one per in-flight mission; registered in .git/worktrees/)
.worktrees/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/

# Wrangler's local state for the docs Worker (build output, uploaded-asset
# manifest, local dev storage) — regenerated on every deploy.
docs/.wrangler/

# Local release-scan denylist (per-machine backstop; terms must not be published)
.workaholic/leak-denylist

# Logs and local env
*.log
.env
.env.*
!.env.example
.DS_Store

# Real-run comparison report + artifact are REGENERATED on demand
# (`npm run compare:render`) from the committed history/ archives — the real-data
# source of truth. The rendered `.real` outputs are non-deterministic and not
# committed (unlike the byte-stable fixture `llm-model-comparison.md`/`.data.json`).
docs/research-reports/*.real.md
docs/research-reports/*.real.data.json
docs/research-reports/*.fixture.md
docs/research-reports/*.fixture.data.json
# Real-run generated images land here transiently before being moved into the
# committed dated frame's images/ directory by research:archive.
docs/research-reports/*.real.images/

# Regenerable artifact-to-draft skeletons for the canonical LLM foundation IA.
docs/llm-foundation/_generated/

# BEIR/SciFact corpus cache (fetched, CC BY-NC — never committed; see scripts/fetch-scifact.sh)
packages/tech/.cache/
